msgid "GAMEPAD 1 AND KEYBOARD SHARE PORT 1"
msgstr "GAMEPAD 1 Y TECLADO COMPARTEN EL PUERTO 1"

msgctxt "setting_input_share_port1_help"
msgid "The keyboard plays on port 1 together with the gamepad that joined port 1. Off: the keyboard joins its own port with START."
msgstr "El teclado juega en el puerto 1 junto con el gamepad que se unió al puerto 1. Apagado: el teclado se une a su propio puerto con START."

