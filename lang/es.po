msgid "BOTTOM LEFT"
msgstr "ABAJO IZQUIERDA"

msgctxt "value_position_bottom"
msgid "BOTTOM"
msgstr "ABAJO"

msgctxt "value_position_bottom_right"
msgid "BOTTOM RIGHT"
msgstr "ABAJO DERECHA"

