msgstr "ESTA GPU: ESPERA A QUE EL FRAME ESTÉ EN PANTALLA"

msgctxt "present_wait_gpu"
msgid "THIS GPU: NO PRESENT WAIT, WAITS FOR THE GPU INSTEAD"
msgstr "ESTA GPU: SIN ESPERA DE PRESENTACIÓN, ESPERA A LA GPU"

