msgctxt "section_low_latency"
msgid "LOW LATENCY"
msgstr "BAJA LATENCIA"

msgctxt "frame_delay_needs_wait"
msgid "ONLY WITH WAIT FOR PRESENT: WITHOUT IT THE LOOP WAITS FOR THE DISPLAY AFTER READING INPUT, SO A DELAY ONLY ADDS LATENCY."
msgstr "SOLO CON ESPERAR LA PRESENTACIÓN: SIN ESO EL CICLO ESPERA A LA PANTALLA DESPUÉS DE LEER LOS CONTROLES, ASÍ QUE UN RETARDO SOLO SUMA LATENCIA."

msgctxt "latency_preset"
msgid "PRESET"
msgstr "PERFIL"

msgctxt "latency_preset_help"
msgid "Sets the three settings below. Change them one by one for anything in between."
msgstr "Fija los tres ajustes de abajo. Cámbialos uno por uno para algo intermedio."

