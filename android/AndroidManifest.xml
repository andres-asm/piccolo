<?xml version="1.0" encoding="utf-8"?>
<!-- piccolo for Android. Based on SDL3's android-project manifest
     (deps/SDL/android-project/app/src/main/AndroidManifest.xml), cut down to
     what piccolo needs. Phones/tablets and Android TV from one APK.
     Linked against API 32's android.jar (see build-apk.sh): attributes from
     API 33+ (enableOnBackInvokedCallback, grammaticalGender) are left out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.andres_asm.piccolo"
    android:versionCode="1"
    android:versionName="0.1"
    android:installLocation="auto">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <!-- Vulkan 1.1+ (the renderer itself needs 1.3 features; checked at runtime). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />

    <!-- Nothing below is required: TVs have no touchscreen, phones have no leanback. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <!-- Rumble -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application android:label="piccolo"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true">

        <!-- preferMinimalPostProcessing: ask the TV for its game mode (ALLM). -->
        <activity android:name=".PiccoloActivity"
            android:label="piccolo"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
