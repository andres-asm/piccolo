[submodule "deps/SDL"]
	path = deps/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "deps/imgui"]
	path = deps/imgui
	url = https://github.com/ocornut/imgui.git
[submodule "deps/libretro-common"]
	path = deps/libretro-common
	url = https://github.com/libretro/libretro-common.git
	shallow = true
[submodule "deps/libsamplerate"]
	path = deps/libsamplerate
	url = https://github.com/libsndfile/libsamplerate.git
[submodule "deps/gamemode"]
	path = deps/gamemode
	url = https://github.com/FeralInteractive/gamemode.git
[submodule "deps/librashader"]
	path = deps/librashader
	url = https://github.com/SnowflakePowered/librashader.git
	shallow = true
[submodule "deps/common/hosts-common"]
	path = deps/common/hosts-common
	url = https://github.com/multitap-org/hosts-common.git
[submodule "deps/common/frontends-common"]
	path = deps/common/frontends-common
	url = https://github.com/multitap-org/frontends-common.git
[submodule "deps/libretro/host-libretro"]
	path = deps/libretro/host-libretro
	url = https://github.com/multitap-org/host-libretro.git
[submodule "deps/libretro/frontend-libretro"]
	path = deps/libretro/frontend-libretro
	url = https://github.com/multitap-org/frontend-libretro.git
[submodule "deps/test-libretro"]
	path = deps/test-libretro
	url = https://github.com/multitap-org/test-libretro.git
	update = none
[submodule "deps/miniz"]
	path = deps/miniz
	url = https://github.com/richgel999/miniz.git
[submodule "deps/7zip"]
	path = deps/7zip
	url = https://github.com/ip7z/7zip.git
	shallow = true
[submodule "deps/piccolo-shaders"]
	path = deps/piccolo-shaders
	url = https://github.com/multitap-org/piccolo-shaders.git
	branch = piccolo
	shallow = true
[submodule "deps/enet"]
	path = deps/enet
	url = https://github.com/zpl-c/enet.git
[submodule "deps/monocypher"]
	path = deps/monocypher
	url = https://github.com/LoupVaillant/Monocypher.git
[submodule "deps/beacon"]
	path = deps/beacon
	url = https://github.com/multitap-org/multitap-beacon.git
[submodule "deps/libdatachannel"]
	path = deps/libdatachannel
	url = https://github.com/paullouisageneau/libdatachannel.git
[submodule "deps/qrcodegen"]
	path = deps/qrcodegen
	url = https://github.com/nayuki/QR-Code-generator.git
